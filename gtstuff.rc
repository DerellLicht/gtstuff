#include <windows.h>
#include "resource.h"

GTSTUFF_ICO       ICON    "scroll.ico"

//*******************************************************************
//  main-dialog menu bar
//  Claude 08/17/26 - attached to the dialog via the MENU statement below,
//  so it's part of the window from CreateDialog() time -- this is why it
//  doesn't disturb the status bar layout the way a runtime SetMenu() call
//  did previously: cxClient/cyClient never get measured until *after* the
//  menu already exists, so nothing downstream ever sees a stale pre-menu
//  client size.
//*******************************************************************
IDM_MAINMENU MENU
BEGIN
   POPUP "&File"
   BEGIN
      MENUITEM "&Circles",  IDM_CIRCLES
      MENUITEM "&Squares",  IDM_SQUARES
      MENUITEM SEPARATOR
      MENUITEM "&Close",    IDM_FILE_CLOSE
   END
END

//*******************************************************************
//  main dialog
//*******************************************************************
// IDD_MAIN_DIALOG DIALOG DISCARDABLE  160, 40, 350, 370
IDD_MAIN_DIALOG DIALOGEX  160, 40, 350, 250
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX
// EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Terminal utility"
MENU IDM_MAINMENU
FONT 10, "Times New Roman"
BEGIN
   LTEXT           "Graph info", IDS_GINFO,  10,  5,  40,  10, SS_SUNKEN
   LTEXT           " ",          IDC_GINFO,  55,  5, 150,  10, SS_SUNKEN
   DEFPUSHBUTTON  "Close",       IDB_CLOSE, 210,  5,  40,  11
   
   //  Claude 08/17/26 - plain static, not SS_BLACKFRAME -- we draw the
   //  frame's fill, border, and content ourselves (see draw_gframe_contents()
   //  in gtstuff.cpp), so this control only needs to reserve screen space and
   //  give us an hwnd/HDC to draw into. SS_LEFT with no text draws nothing on
   //  its own, so there's no risk of its own painting fighting with ours.
   // LTEXT           " ",           IDC_GBORDER, 2, 1, 200, 200, 0, WS_EX_CLIENTEDGE
   CONTROL         "",            IDC_GFRAME, "Static", SS_LEFT,  4, 20, 342, 200
END

