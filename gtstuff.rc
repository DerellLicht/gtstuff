//  Interesting notes about this file:
//  
//  > SS_NOTIFY and "Static" controls
//    If SS_NOTIFY is not specified in the control styles,
//    you cannot attach tooltips to the control.
//  
//****************************************************************************
#include <windows.h>
#include "resource.h"

GTSTUFF_ICO       ICON    "scroll.ico"

//*******************************************************************
//  main-dialog menu bar
//  Claude 08/17/26 - attached to the dialog via the MENU statement below,
//  so it's part of the window from CreateDialog() time -- this is why it
//  doesn't disturb the status bar layout the way a runtime SetMenu() call
//  did previously: cxClient/cyClient never get measured until *after* the
//  menu already exists, so nothing downstream ever sees a stale pre-menu
//  client size. 
//*******************************************************************
//  Derell, 08/19/26 - replaced menu bar with combobox dropdownlist
//*******************************************************************
// IDM_MAINMENU MENU
// BEGIN
//    POPUP "File"
//    BEGIN
//       MENUITEM "Circles",         IDM_CIRCLES
//       [ and others ... ]
//       MENUITEM SEPARATOR
//       MENUITEM "Close",           IDM_FILE_CLOSE
//    END
// END

//*******************************************************************
//  main dialog
//*******************************************************************
// IDD_MAIN_DIALOG DIALOG DISCARDABLE  160, 40, 350, 370
IDD_MAIN_DIALOG DIALOGEX  160, 40, 350, 250
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX
// EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Terminal utility"
// MENU IDM_MAINMENU
FONT 10, "Times New Roman"
BEGIN
   LTEXT       "Gobject:",        IDS_GOBJECT,   10,  7,  37,  10, SS_NOTIFY
   COMBOBOX                       IDC_GOBJECT,   50,  5, 150, 200, CBS_DROPDOWNLIST | WS_VSCROLL | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS
                                  
   LTEXT       "Palette:",        IDS_PALETTE,  240,  6,  26,  10, SS_NOTIFY
   LTEXT       " ",               IDC_PALETTE,  270,  5,  20,  10, SS_SUNKEN | SS_NOTIFY
   LTEXT       " ",               IDC_PALNAME,  295,  5, 150,  10, SS_SUNKEN | SS_NOTIFY
                                  
   LTEXT       "Graph info:",     IDS_GINFO,     10, 21,  37,  10, SS_NOTIFY
   LTEXT       " ",               IDC_GINFO,     50, 20, 150,  10, SS_SUNKEN | SS_NOTIFY
   PUSHBUTTON  "Pause",           IDB_PAUSE,    250, 18,  40,  11
   PUSHBUTTON  "Solid Pattern",   IDB_PSOLID,   295, 18,  50,  11
   PUSHBUTTON  "Custom",          IDB_CUSTOM,   350, 18,  40,  11
   PUSHBUTTON  "Close",           IDB_CLOSE,    405, 18,  40,  11
   
   //  Claude 08/17/26 - plain static, not SS_BLACKFRAME -- we draw the
   //  frame's fill, border, and content ourselves (see draw_gframe_contents()
   //  in gtstuff.cpp), so this control only needs to reserve screen space and
   //  give us an hwnd/HDC to draw into. SS_LEFT with no text draws nothing on
   //  its own, so there's no risk of its own painting fighting with ours.
   //
   //  WS_EX_CLIENTEDGE (trailing exstyle param below) adds a decorative
   //  sunken 3D edge, drawn by Windows itself as part of this window's
   //  non-client area (WM_NCPAINT, not our own WM_PAINT -- doesn't interact
   //  with the subclassing in GFrameSubclassProc at all). GetClientRect()
   //  automatically excludes it, same as it already does for the thick-frame
   //  border and caption on hwndMain, so cxGFrame/cyGFrame need no changes --
   //  and it resizes for free since it's just one property of the same
   //  window resize_gframe() already tracks, not a second window to keep in sync. 
   //  Rejected the separate-IDC_GBORDER-control idea below for exactly that reason.
   // LTEXT           " ",           IDC_GBORDER, 2, 1, 200, 200, 0, WS_EX_CLIENTEDGE
   CONTROL         "",            IDC_GFRAME, "Static", SS_LEFT,  4, 20, 342, 200, WS_EX_CLIENTEDGE
END

